exports[`golden input schema shapes for every profile 1`] = `
{
  "full": [
    {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "bundleId": {
            "type": "string",
          },
          "country": {
            "type": "string",
          },
          "developerName": {
            "type": "string",
          },
          "displayName": {
            "type": "string",
          },
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "contentType": {
                  "enum": [
                    "application/vnd.android.package-archive",
                    "application/octet-stream",
                    "application/zip",
                  ],
                  "type": "string",
                },
                "fileName": {
                  "minLength": 1,
                  "type": "string",
                },
                "sha256": {
                  "type": "string",
                },
              },
              "required": [
                "contentType",
                "fileName",
              ],
              "type": "object",
            },
            "minItems": 1,
            "type": "array",
          },
          "iconURL": {
            "format": "uri",
            "type": "string",
          },
          "id": {
            "format": "uuid",
            "type": "string",
          },
          "operation": {
            "enum": [
              "list",
              "get",
              "versions",
              "create_upload_url",
              "confirm_upload",
              "mark_failed",
              "delete",
              "storage_usage",
            ],
            "type": "string",
          },
          "order": {
            "enum": [
              "asc",
              "desc",
            ],
            "type": "string",
          },
          "page": {
            "exclusiveMinimum": 0,
            "type": "integer",
          },
          "pageSize": {
            "exclusiveMinimum": 0,
            "maximum": 100,
            "type": "integer",
          },
          "platform": {
            "enum": [
              "all",
              "android",
              "ios",
            ],
            "type": "string",
          },
          "query": {
            "type": "string",
          },
          "sizeBytes": {
            "exclusiveMinimum": 0,
            "type": "integer",
          },
          "sortBy": {
            "enum": [
              "createdAt",
              "name",
            ],
            "type": "string",
          },
          "status": {
            "enum": [
              "all",
              "queued",
              "available",
              "failed",
              "pruned",
            ],
            "type": "string",
          },
          "targetSdk": {
            "type": "integer",
          },
          "uploadPlatform": {
            "enum": [
              "android",
              "ios",
            ],
            "type": "string",
          },
          "versionCode": {
            "type": "integer",
          },
          "versionName": {
            "type": "string",
          },
        },
        "required": [
          "operation",
        ],
        "type": "object",
      },
      "name": "apps",
    },
    {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "answers": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "custom": {
                        "minLength": 1,
                        "type": "string",
                      },
                      "label": {
                        "minLength": 1,
                        "type": "string",
                      },
                    },
                    "required": [
                      "custom",
                      "label",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "minLength": 1,
                        "type": "string",
                      },
                    },
                    "required": [
                      "label",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "custom": {
                        "minLength": 1,
                        "type": "string",
                      },
                    },
                    "required": [
                      "custom",
                    ],
                    "type": "object",
                  },
                ],
              },
              "type": "array",
            },
            "type": "array",
          },
          "expectedTurnId": {
            "minLength": 1,
            "type": "string",
          },
