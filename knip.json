{
  "$schema": "https://unpkg.com/knip@6.40.0/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/tools": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/server": {
      "entry": [
        "src/index.ts",
        "src/stdio.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
